# Test environment — used with `docker compose -f docker-compose.yml -f docker-compose.test.yml up`
# Spins up the app + its postgres + a northwind sample database on localhost:5434.

DB_PASSWORD=test-secret
SECRET_KEY=test-secret-key-do-not-use-in-production

# Northwind test database (local compose override)
NORTHWIND_HOST=localhost
NORTHWIND_PORT=5434
NORTHWIND_DATABASE=northwind
NORTHWIND_USER=northwind
NORTHWIND_PASSWORD=northwind
