{
  "instantreports_export": true,
  "version": "1.0",
  "report": {
    "name": "Regional Sales Summary",
    "description": "Sales data grouped by region with subtotals and charts",
    "definition": {
      "name": "Regional Sales Summary",
      "description": "Sales data grouped by region with subtotals and charts",
      "data_sources": [
        {
          "id": "sales_by_region",
          "name": "Northwind Regional Sales",
          "connector_type": "postgresql",
          "connection_id": "00000000-0000-0000-0000-000000000001",
          "query": "SELECT c.country AS region, cat.category_name AS product_category, SUM(od.quantity) as total_qty, SUM(od.quantity * od.unit_price) as total_revenue, COUNT(DISTINCT o.order_id) as order_count FROM order_details od JOIN orders o ON od.order_id = o.order_id JOIN customers c ON o.customer_id = c.customer_id JOIN products p ON od.product_id = p.product_id JOIN categories cat ON p.category_id = cat.category_id GROUP BY c.country, cat.category_name ORDER BY total_revenue DESC"
        }
      ],
      "parameters": [],
      "layout": {
        "page": {
          "size": "A4",
          "orientation": "landscape"
        },
        "sections": [
          {
            "type": "header",
            "elements": [
              {
                "type": "text",
                "content": "Regional Sales Summary Report",
                "style": "title"
              },
              {
                "type": "text",
                "content": "Report Date: {{date.today}}",
                "style": "subtitle"
              }
            ]
          },
          {
            "type": "detail",
            "data_source": "sales_by_region",
            "group_by": "region",
            "elements": [
              {
                "type": "text",
                "content": "Region: {{group.region}}",
                "style": "group_header"
              },
              {
                "type": "table",
                "columns": [
                  {
                    "field": "product_category",
                    "header": "Category"
                  },
                  {
                    "field": "total_qty",
                    "header": "Total Qty",
                    "format": "#,##0"
                  },
                  {
                    "field": "total_revenue",
                    "header": "Total Revenue",
                    "format": "$#,##0.00"
                  },
                  {
                    "field": "order_count",
                    "header": "Orders",
                    "format": "#,##0"
                  }
                ],
                "group_footer": {
                  "show": true,
                  "elements": [
                    {
                      "type": "text",
                      "content": "Region Total: Revenue ${{group.total_revenue | sum | currency}}",
                      "style": "bold"
                    }
                  ]
                }
              },
              {
                "type": "chart",
                "chart_type": "bar",
                "x_field": "product_category",
                "y_field": "total_revenue",
                "title": "Revenue by Category"
              }
            ]
          },
          {
            "type": "summary",
            "elements": [
              {
                "type": "text",
                "content": "Executive Summary",
                "style": "heading"
              },
              {
                "type": "table",
                "data_source": "sales_by_region",
                "columns": [
                  {
                    "field": "region",
                    "header": "Region"
                  },
                  {
                    "field": "total_revenue",
                    "header": "Total Revenue",
                    "format": "$#,##0.00"
                  },
                  {
                    "field": "order_count",
                    "header": "Total Orders",
                    "format": "#,##0"
                  }
                ],
                "sort": "total_revenue DESC"
              }
            ]
          },
          {
            "type": "footer",
            "elements": [
              {
                "type": "text",
                "content": "Page {{page.number}} | Confidential",
                "style": "footer"
              }
            ]
          }
        ]
      },
      "export_settings": {
        "pdf": {
          "enabled": true
        },
        "xlsx": {
          "enabled": true
        }
      }
    }
  }
}