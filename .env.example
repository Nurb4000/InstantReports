# InstantReports Environment Configuration
# Copy to .env and adjust values as needed

MODE=designer
DB_PASSWORD=secret
SECRET_KEY=change-me-in-production

# LDAP (configure for production, use mokapi for testing)
LDAP_URL=ldap://localhost:389
LDAP_BIND_DN=cn=admin,dc=mokapi,dc=org
LDAP_BIND_PASSWORD=password
LDAP_SEARCH_BASE=ou=users,dc=mokapi,dc=org

# AI (llama.cpp default, or configure OpenAI)
AI_BASE_URL=http://localhost:8080/v1
AI_API_KEY=none
AI_MODEL=local-model

# SMTP (for report delivery)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reports@example.com
