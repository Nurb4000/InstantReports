# InstantReports Environment Configuration
# Copy to .env and adjust values as needed

DB_PASSWORD=secret
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Bootstrap admin (created on first run if the users table is empty).
# Leave INITIAL_ADMIN_PASSWORD blank to skip seeding. The password must be at
# least 8 characters and not a common placeholder.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=

# LDAP (optional — configure for production use)
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=

# AI (llama.cpp default, or configure OpenAI)
AI_BASE_URL=http://localhost:8080/v1
AI_API_KEY=none
AI_MODEL=local-model
AI_ENABLED=false

# SMTP (for report delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reports@example.com

# Cookies: set to true when served over HTTPS (recommended in production).
COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API (blank = same-origin
# only). Never use "*" here.
CORS_ALLOW_ORIGINS=
