# InstantReports Environment Configuration
# Copy to .env and adjust values as needed

DB_PASSWORD=secret
SECRET_KEY=your-secret-key-here

# Default admin user (created on first run if no users exist)
# Email: admin@example.com
# Password: admin

# LDAP (optional — configure for production use)
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=

# AI (llama.cpp default, or configure OpenAI)
AI_BASE_URL=http://localhost:8080/v1
AI_API_KEY=none
AI_MODEL=local-model
AI_ENABLED=false

# SMTP (for report delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reports@example.com
